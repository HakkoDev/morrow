{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions for the mail client",
  "windows": [
    "main",
    "compose-*"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close"
  ]
}
