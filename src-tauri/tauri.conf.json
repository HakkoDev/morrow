{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Morrow",
    "version": "0.1.6",
    "identifier": "app.morrow.mail",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist",
        "windows": {
            "staticVCRuntime": true
        }
    },
    "app": {
        "windows": [
            {
                "title": "Morrow",
                "width": 1440,
                "height": 900,
                "minWidth": 1000,
                "minHeight": 650,
                "resizable": true,
                "fullscreen": false,
                "label": "main"
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' asset: data: https: http:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' data:; object-src 'none'; base-uri 'none'"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
    },
    "plugins": {
        "updater": {
            "pubkey": "",
            "endpoints": [],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
