{
    "name": "morrow-mail",
    "private": true,
    "version": "0.1.5",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "tauri:dev": "node scripts/sync-tauri-lock.mjs --sync && tauri dev",
        "tauri:build": "node scripts/sync-tauri-lock.mjs --sync && tauri build --bundles nsis",
        "typecheck": "tsc --noEmit",
        "check": "bun run quality && bun run build",
        "tauri:build:windows": "node scripts/sync-tauri-lock.mjs --sync && tauri build --bundles nsis",
        "tauri:build:all": "node scripts/sync-tauri-lock.mjs --sync && tauri build",
        "test:source": "node --test",
        "release:configure": "node scripts/prepare-release.mjs",
        "tauri:build:signed": "node scripts/sync-tauri-lock.mjs --sync && node scripts/prepare-release.mjs && tauri build --bundles nsis --config src-tauri/tauri.release.conf.json",
        "tauri:build:linux": "node scripts/sync-tauri-lock.mjs --sync && tauri build --bundles appimage,deb",
        "release:notes": "node scripts/generate-release-notes.mjs",
        "release:verify": "node scripts/verify-release-assets.mjs",
        "format": "bun run format:biome && bun run format:rust",
        "format:biome": "biome format --write .",
        "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
        "format:check": "bun run format:biome:check && bun run format:rust:check",
        "format:biome:check": "biome format .",
        "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
        "lint": "bun run lint:biome && bun run lint:rust",
        "lint:biome": "biome lint .",
        "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets",
        "biome:check": "biome ci .",
        "biome:fix": "biome check --write .",
        "quality": "bun run biome:check && bun run format:rust:check && bun run lint:rust && bun run typecheck && bun run test:source",
        "deps:sync": "bun install && node scripts/sync-tauri-lock.mjs --sync",
        "deps:check": "node scripts/sync-tauri-lock.mjs --check"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tauri-apps/api": "2.12.3",
        "@tauri-apps/plugin-dialog": "^2.4.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dompurify": "^3.4.17",
        "lucide-react": "^0.468.0",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "tailwind-merge": "^3.7.0",
        "@tauri-apps/plugin-updater": "^2",
        "@tauri-apps/plugin-process": "^2"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "2.12.2",
        "@types/react": "^19.1.10",
        "@types/react-dom": "^19.1.7",
        "@vitejs/plugin-react": "^6.1.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.8.3",
        "vite": "^8.0.0",
        "@biomejs/biome": "2.5.15"
    }
}
